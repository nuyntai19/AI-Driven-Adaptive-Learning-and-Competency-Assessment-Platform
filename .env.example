COMPOSE_PROJECT_NAME=edutwin

# Database
MYSQL_DATABASE=edutwin
MYSQL_USER=edutwin_user
MYSQL_PASSWORD=edutwin_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3307

# Ports
API_PORT=5000
WEB_PORT=3000
ADMINER_PORT=8080

# API Settings
ConnectionStrings__Default=Server=mysql;Port=3306;Database=edutwin;User=edutwin_user;Password=edutwin_password;
Jwt__SigningKey=YOUR_DEVELOPMENT_SIGNING_KEY_HERE
Jwt__Issuer=EduTwinAuth
Jwt__Audience=EduTwinUsers
# JSON array of keys; retain the double quotes around each key.
# This list takes precedence over the legacy Gemini__ApiKey/BackupKeys settings.
GEMINI_LIST_KEY=["YOUR_GEMINI_API_KEY_1","YOUR_GEMINI_API_KEY_2"]
Gemini__Model=gemini-3.5-flash-lite
# Jobs can overlap inference, while provider calls are limited per verified project.
AIAnalysisWorker__MaxConcurrentJobs=4
Gemini__MaxConcurrentRequests=2
# Optional JSON array; see docs/plans/AI-GRADING-THROUGHPUT.md for verified quota metadata.
GEMINI_QUOTA_POOLS=[]
# Coalesce only same-center/student/assignment questions. No model switch by default.
AIGrading__MicroBatchEnabled=true
AIGrading__BatchSize=3
AIGrading__BatchWindow=00:00:00.150
AIGrading__Provider=Gemini
AIGrading__GeminiModel=
AIGrading__AlternativeProfileApproved=false
# Optional experimental provider; set privately only after quality/terms review.
AIGrading__GroqApiKey=
AIGrading__GroqOrganizationId=unverified-groq-organization
AIGrading__GroqModel=qwen/qwen3.8-27b
Logging__LogLevel__Default=Information

# Health Checks
HealthChecks__MySqlHost=mysql
HealthChecks__MySqlPort=3306

# Frontend Configuration
# Lưu ý: P02 không cần cấu hình VITE_API_BASE_URL.
# Frontend sử dụng same-origin path /api/v1.
# Nginx sẽ làm nhiệm vụ reverse proxy đường dẫn /api/ tới http://api:8080/api/.

ASPNETCORE_ENVIRONMENT=Development
Seed__Enabled=true
Seed__CenterManagerPassword=change_me_to_a_secure_seed_password

# Platform Bootstrap
PlatformBootstrap__AdminUsername=platform.admin
PlatformBootstrap__AdminDisplayName=Platform Administrator
PlatformBootstrap__AdminPassword=change_me_to_a_secure_platform_admin_password

